    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "test-app"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "test-app"
        },
        "annotations": {
          "eval.protocol/run": "protocol-8953b24b78b8"
        }
      },
      "spec": {
        "containers": [
          {
            "image": "ANON_RESOURCE_001.azurecr.io/tset-app:1.4.2",
            "imagePullPolicy": "IfNotPresent",
            "name": "api",
            "ports": [
              {
                "containerPort": 80,
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
